# =============================================================================
# sdkconfig.defaults  —  GUITION JC-ESP32P4-M3-DEV
# ESP32-P4 + ESP32-C6 SDIO WiFi
# =============================================================================

# ── Target ────────────────────────────────────────────────────────────────────
CONFIG_IDF_TARGET="esp32p4"

# ── Flash ─────────────────────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ── CPU frequency: 360 MHz. 400 MHz broke PSRAM access timing and ~2x slowed
#    the PSRAM-resident tensor arena (memory-bound inference). Keep 360.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# ── Performance build for TFLite-Micro / ESP-NN inference ─────────────────────
# -O2 instead of debug -Og: 2-3x faster int8 conv kernels. Assertions off.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
# NOTE: L2 cache left at default 128KB. Raising it to 512KB steals on-chip SRAM
# and crashes boot with "Could not reserve internal/DMA pool" (0x101).

# ── FreeRTOS (1000 Hz = 1ms tick resolution) ──────────────────────────────────
CONFIG_FREERTOS_HZ=1000
# ESP-Hosted SDIO and console traffic can nest while the AI task is logging.
# The 1536-byte default was exhausted during classifier diagnostics.
CONFIG_FREERTOS_ISR_STACKSIZE=4096

# ── Console / UART ────────────────────────────────────────────────────────────
# Use UART as primary — USB_SERIAL_JTAG gives no app logs on GUITION boards
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# ── PSRAM (GUITION has 32MB HEX-mode PSRAM stacked in package) ───────────────
# IDF_EXPERIMENTAL_FEATURES is required to unlock 200 MHz PSRAM support
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# ── Custom partition table ────────────────────────────────────────────────────
# Required: includes the slave_fw partition for C6 firmware storage
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── esp_hosted ────────────────────────────────────────────────────────────────
# The ESP32-C6 is the WiFi co-processor; it talks to the P4 over SDIO.
# GUITION-SPECIFIC: reset is active HIGH (most boards are active LOW!)
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"

# Reset pin: GPIO54, active HIGH  ← DO NOT CHANGE — board-specific
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=54

# SDIO bus: 4-bit @ 40 MHz
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_RESET_DELAY_MS=1500

# SDIO pin mapping (confirmed for GUITION JC-ESP32P4-M3-DEV)
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17

# ── esp_wifi_remote ───────────────────────────────────────────────────────────
# Thin shim that routes esp_wifi_* API calls through esp_hosted to the C6
# NOTE: use CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED, NOT CONFIG_ESP_WIFI_ENABLED
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

# ── WiFi stability tweaks ─────────────────────────────────────────────────────
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# ── lwIP TCP window (default 5760 is too small, caps TCP at ~15 Mbps) ─────────
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# ── SDIO queue sizes (improves throughput) ────────────────────────────────────
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=20
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=20
